# ==============================================================================
# Automated Multi-Platform Posting System - Environment Variables
# Copy this file to .env and provide your actual credentials.
# All API keys and secrets should be kept private and never committed to Git.
# ==============================================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=4000

# Testing / Mock Mode:
# Set MOCK_MODE=true to simulate posting across all platforms without live API calls.
# Set MOCK_MODE=false to execute actual live API publishing.
MOCK_MODE=false

# ------------------------------------------------------------------------------
# 1. Bluesky (AT Protocol)
# Developer Portal / Docs: https://docs.bsky.app
# Create an App Password at: https://bsky.app/settings/app-passwords
# ------------------------------------------------------------------------------
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_app_password
BLUESKY_PDS_URL=https://bsky.social

# ------------------------------------------------------------------------------
# 2. Mastodon
# Developer Portal / Docs: https://docs.joinmastodon.org/client/intro/
# Create an Application at: https://mastodon.social/settings/applications (or your instance)
# ------------------------------------------------------------------------------
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token

# ------------------------------------------------------------------------------
# 3. Telegram
# Developer Portal / Docs: https://core.telegram.org/bots/api
# Create a Bot with @BotFather: https://t.me/BotFather
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@your_public_channel_username

# ------------------------------------------------------------------------------
# 4. Discord (Webhook)
# Developer Portal / Docs: https://discord.com/developers/docs/resources/webhook
# Create Webhook in Server Settings -> Integrations -> Webhooks
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------------------------
# 5. Reddit
# Developer Portal / Docs: https://www.reddit.com/dev/api/
# Create an App (script) at: https://www.reddit.com/prefs/apps
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_SUBREDDIT=test
